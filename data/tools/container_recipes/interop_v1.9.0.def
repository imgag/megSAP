Bootstrap: docker
From: ubuntu:24.04

%post
export LANG=C.UTF-8
export LC_ALL=C.UTF-8

# Update package list and install dependencies
apt-get update --fix-missing
apt-get install -y \
    wget \
    tar \
    gzip

# Download and extract interop pre-built binary
cd /tmp
wget https://github.com/Illumina/interop/releases/download/v1.9.0/interop-1.9.0-Linux-GNU.tar.gz
tar xzf interop-1.9.0-Linux-GNU.tar.gz
rm interop-1.9.0-Linux-GNU.tar.gz

# Move binaries to opt directory
mkdir -p /opt/interop/bin
cp -r interop-1.9.0-Linux-GNU/bin/* /opt/interop/bin/

# Cleanup
rm -rf interop-1.9.0-Linux-GNU
cd /

# Remove build dependencies
apt-get remove -y \
    wget
apt-get autoremove -y
apt-get clean
rm -rf /var/lib/apt/lists/*

%environment
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
export PATH=/opt/interop/bin:$PATH